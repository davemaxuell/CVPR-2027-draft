[
  {
    "id": "idealvln",
    "title": "Instruction Decomposition and Action Alignment for Vision-and-Language Navigation",
    "authors": [
      "Zihao Xin",
      "Wentong Li",
      "Yixuan Jiang",
      "Bin Wang",
      "Piji Li",
      "Jianke Zhu",
      "Jie Qin",
      "Shengjun Huang"
    ],
    "year": 2026,
    "venue": "ICML 2026, PMLR 306 (paper masthead)",
    "source": "https://raw.githubusercontent.com/mlresearch/v306/main/assets/xin26a/xin26a.pdf",
    "pages": "1, 3–8",
    "problem": "Full-instruction VLM policies repeatedly encode long histories and can choose an action relevant to a different instruction stage. IDEAL-VLN targets this stage-alignment and inference-cost problem in monocular R2R/RxR-CE. Training has privileged reference paths and aligned sub-instructions; deployment uses RGB and language.",
    "method": "Sections 3.1–3.3, Eqs.1–6: first infer semantic anchor S_t ~ Pθ(S|O_1:t,L,ρ_decomp), then action A_t ~ Pθ(A|I_t,S_t,ρ_act), withholding global L and history from the second prompt. This enforces the implemented input separation, not by itself an identifiable causal effect: writing do(S_t) does not establish causal identification. The displayed conditional independence assumes no hidden reuse of L through cached states beyond S_t. The trigger called 'entropy-based' is actually two deterministic action-sequence predicates: both Left and Right appear among N predicted micro-actions, or k same-direction rotations occur. It does not calculate Shannon entropy. During correction, word-overlap precision R=|W(S_pred)∩W(S_gt)|/|W(S_pred)| uses nearest reference-waypoint segments and replaces predictions when R<τ=.8. A degenerate short generic phrase can have high precision without covering required intent; empty-denominator behavior is unspecified in reviewed text. Expert action intervention is Bernoulli with P_int(d)=sigmoid(3(d−1.5)), where d is geodesic cross-track distance in meters, so k has inverse-meter units. This is a soft sampling policy, not a safety guarantee. The 160K alignment pairs span61MP3Dscenes. Qwen2.5-VL7B freezes vision/projector, AdamW batch128, lr2e−5 cosine, warmup.03,8H100. Extra-data version adds ScaleVLN150K and80KLLaVA-Video QA. Token-level supervised optimization is implied by fine-tuning; exact loss masking requires appendix/release inspection. Inference uses current RGB plus compact anchor; reanchoring uses history. Table6 estimates147K→77K tokens/episode. Concurrent ~2s thought is masked by3–5s physical action execution, conditional on that timing assumption.",
    "novelty": "An explicit semantic mediator that is the only language input to action selection, plus joint thought/action correction with distance-dependent expert mixing. Related AwareVLN/AdaNav already gate reasoning; CorrectNav already collects recovery trajectories. The distinctive input bottleneck should be evaluated independently of those data improvements. Its causal terminology is stronger than the experimentally established architectural separation.",
    "results": "Tables1–2: base R2R56.7SR/51.6SPL andRxR55.9/48.2; extra-data59.8/52.9 and59.1/50.7. Figure2 RxR42.7→51.1 with Think-Before-Act,55.9 with correction,59.1 extra data. Table3 LLM confidence trigger35.8SR, SigLIP51.5, action-pattern51.1; efficiency is competitive, not uniquely strongest accuracy. Table4 DAgger51.6, STC53.2,full55.9. This supports decomposition plus correction on these settings, not proof that spurious causal correlations were removed. As of cutoff the SOTA prose is not a global ranking: supplied CorrectNav/AwareVLN report higher SR under different training/data.",
    "code": "Advertised project https://allenxinn.github.io/IDEALVLN returned404 during this investigation. No official implementation was inspected or executed; InternNav references are not treated as this paper's released code.",
    "repository_status": "Advertised project unavailable; official code unverified",
    "bottlenecks": [
      {
        "id": "IDEAL-1",
        "description": "Semantic mediator errors can erase essential global constraints",
        "conditions": "Ambiguous alignment, off-path recovery, instructions whose future condition changes current action",
        "cause": "Compressed S_t may not be a sufficient statistic; word-overlap precision is not semantic equivalence",
        "evidence": "§3.3 explicitly says large deviations invalidate semantic support; Eq.5 and soft-gate Eq.6",
        "followups": "CorrectNav/AwareVLN address recovery; none establishes mediator sufficiency or calibrated semantic validity",
        "kind": "Methodological / insufficiently tested",
        "status": "Partially addressed; frontier remains uncertain",
        "confidence": "Moderate"
      }
    ],
    "key_findings": [
      {
        "claim": "'Entropy-based' trigger is action-pattern detection, and the do-operator does not prove causal identification",
        "evidence_type": "Paper inspection and mathematical deduction",
        "source": "Supplied PDF",
        "locator": "§3.1–3.2, Eqs.2–4"
      }
    ],
    "limitations": "Project inaccessible. Reviewed method/results rather than all appendices; exact training masks, dataset construction, and additional proofs remain unverified. No benchmark executed."

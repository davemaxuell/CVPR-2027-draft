[
  {
    "id": "navgpt",
    "title": "NavGPT: Explicit Reasoning in Vision-and-Language Navigation with Large Language Models",
    "authors": [
      "Gengze Zhou",
      "Yicong Hong",
      "Qi Wu"
    ],
    "year": 2024,
    "venue": "AAAI 2024",
    "source": "https://ojs.aaai.org/index.php/AAAI/article/download/28597/29161",
    "pages": "1, 3–7",
    "problem": "Tests whether a frozen language model can execute navigation instructions without VLN training. It operates on a discrete graph with provided viewpoint IDs and candidates. Visual caption quality and historical object tracking are central challenges; 'purely LLM-based' describes its decision module, not absence of visual or simulator dependencies.",
    "method": "Eq.1: (reasoning,action)=LLM(prompt(system,instruction,VFM(observation),history)). Twenty-four images per viewpoint cover8headings×3elevations,45°FoV. BLIP2 ViT-G FlanT5XL captions each; GPT3.5 summarizes elevations to8direction descriptions. FastRCNN detects objects; simulator depth at bounding-box center and relative heading provide object geometry, filtering within3m. GPT4 ReAct-style reasoning then chooses a valid candidateID orStop. History stores observation/reason/action triples with GPT3.5 summaries. No navigation loss or parameter update is used; captions, depth, IDs and language summaries form a lossy observation bottleneck. Navigation graph actions are not continuous motor commands. The action-space extension A∪R is a prompting formalism: emitting a thought does not interact with the environment or receive new evidence.",
    "novelty": "Early explicit ReAct navigation and empirical analysis of frozenGPT4's planning language. Existing self-monitoring, subgoal decomposition and object grounding are reproduced as prompt behaviors, not invented navigation principles. Direct successors MapGPT and NavGPT2 target graph-memory and visual-caption bottlenecks.",
    "results": "Table1 R2R783trajectories/11unseen scenes34SR/29SPL versusDUET72/60; an untrainedLXMERT-DUET baseline1SR does not equalize pretraining capability. GPT3.5ablation216samples across72scenes:45°FoV16.67SR versus60°10.19; objectinformation11.11→15.97, depth16.67(Table2–3). Authors explicitly acknowledgecaption/summarizationloss. Generated top-down trajectory and instructions are selected qualitative examples, not systematic spatial-reconstruction accuracy or demonstratedfaithfulness.",
    "bottlenecks": [
      {
        "id": "NAVGPT-1",
        "description": "Captioning and summarization omit landmarks and object continuity",
        "conditions": "Long histories or instruction-critical small objects",
        "cause": "Serial image-to-text compression and fixedcaptiongranularity",
        "evidence": "pp.6–7 limitations andTables2–3",
        "followups": "MapGPT uses directGPT4V; NavGPT2 learnsvisualalignment; neither makes generated explanations necessarily causal or faithful",
        "kind": "Methodological / evaluation",
        "status": "Partially addressed",
        "confidence": "Moderate"
      }
    ],
    "limitations": "No benchmark executed. Supplementary prompts not yet reviewed. API model/version/cost differences matter for replication."
  },
